{
  "expo": {
    "name": "MyFinances",
    "slug": "myfinances",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myfinances",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.myfinances.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#10b981",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O MyFinances usa a câmera só para ler o QR Code do computador e conectar este celular.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10b981",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.myfinances.mobile",
      "supportsTablet": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e663eeb3-696f-48c3-8289-c54b8ab6490c"
      }
    }
  }
}
